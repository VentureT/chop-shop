# Chop Shop API — example environment.
# Copy to .env and fill in. The app runs without eBay credentials using
# built-in reference prices; live eBay pricing needs a production keyset.

APP_NAME="Chop Shop API"
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# eBay Developers Program keyset (https://developer.ebay.com/my/keys).
# Use the PRODUCTION keyset: sandbox returns mock data for compatibility search.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Buyer ZIP used for shipping/location context in eBay searches.
DEFAULT_ZIP=75201

# Cache TTL for eBay price lookups (days).
CACHE_TTL_DAYS=7
CACHE_PATH=cache.db

# State whose dismantling / title / parts-sale rules to apply.
STATE=TX
